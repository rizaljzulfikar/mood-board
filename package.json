{
  "name": "mood-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,realtime -c blue,magenta \"next dev\" \"npm:realtime\"",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "realtime": "tsx --env-file-if-exists=.env.local src/realtime/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "^3.0.2",
    "image-size": "^2.0.0",
    "jose": "^5.9.0",
    "mongoose": "^8.9.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
