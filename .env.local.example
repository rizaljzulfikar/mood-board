MINIO_ENDPOINT=http://localhost:9100
MINIO_ACCESS_KEY=moodboard
MINIO_SECRET_KEY=moodboard-secret
MINIO_BUCKET=moodboard
JWT_SECRET=change-me-to-a-long-random-string
# Optional: enables Instagram link imports via the Apify instagram-post-scraper
# actor (https://apify.com/apify/instagram-post-scraper). Without it, Instagram
# links fall back to OG scraping, which Instagram blocks.
# TikTok and Pinterest imports need no token.
# APIFY_TOKEN=apify_api_...

